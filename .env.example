# MET Frost API Client ID
# Get one at https://frost.met.no/auth/requestCredentials.html
# Keeps private to server-side only
FROST_CLIENT_ID=

# Required contact identity for MET Norway API requests. Use an identifiable
# app name plus a real contact URL or email owned by the deployment operator.
MET_USER_AGENT=

# Personal access key for any remote/production test deployment (minimum 16 characters).
# The value is entered once on /access and stored only as a derived HttpOnly cookie.
# Local development on localhost remains open.
APP_ACCESS_TOKEN=

# Optional comma-separated exact origins allowed to perform state-changing requests.
# Normally leave empty; the request's own origin is accepted automatically.
# APP_ALLOWED_ORIGINS=https://your-test-deployment.example
APP_ALLOWED_ORIGINS=

# Secret token required to trigger automated ingestion and aggregation cron jobs
# (minimum 16 characters in production).
# E.g. pass via header 'Authorization: Bearer <CRON_SECRET>' or 'x-cron-secret: <CRON_SECRET>'
CRON_SECRET=

# Optional persistent storage path. Tests set VAERSTASJONEN_DB_FILE to a unique
# operating-system temp directory and never touch data/vaerstasjonen_db.json.
# VAERSTASJONEN_DATA_DIR=/persistent/data
# VAERSTASJONEN_DB_FILE=/persistent/data/vaerstasjonen_db.json
